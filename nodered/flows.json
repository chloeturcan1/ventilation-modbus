    {
        "id": "f0a100000000010a",
        "type": "function",
        "z": "f0a1000000000001",
        "name": "Températures et alarmes",
        "func": "// Registres 16 bits signés (complément à deux), en dixièmes de degré.\nconst SCALE = 10;\nconst LABELS = [\"Arrêt d'urgence\",\"Température intérieure haute\",\"Défaut capteur T_int\",\"Défaut capteur T_ext\",\"Défaut rotation V1\",\"Défaut rotation V2\",\"Défaut rotation V3\",\"Défaut rotation V4\"];\nconst temp = (raw) => ((raw >= 0x8000 ? raw - 0x10000 : raw) / SCALE).toFixed(1) + \" °C\";\nconst alarms = (word) => LABELS.filter((_, bit) => word & (1 << bit)).join(\", \") || \"Aucune\";\nconst r = msg.payload;\nreturn [\n    { payload: temp(r[0]) },\n    { payload: temp(r[1]) },\n    { payload: alarms(r[2]) },\n    { payload: alarms(r[3]) },\n];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 340,
        "wires": [
            [
                "f0a1000000000106"
            ],
            [
                "f0a1000000000107"
            ],
            [
                "f0a1000000000108"
            ],
            [
                "f0a1000000000109"
            ]
        ]
    },
